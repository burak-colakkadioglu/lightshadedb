LIGHTSHADE_CREDENTIALS=/etc/lightshade/messages.credentials
LIGHTSHADE_AUDIT_LOG=/var/log/lightshade/messages.audit.jsonl
LIGHTSHADE_MAX_CONNECTIONS=128
LIGHTSHADE_MAX_TRANSACTIONS=128
LIGHTSHADE_MAX_ROWS=1000000
LIGHTSHADE_MAX_WAL_BYTES=268435456
LIGHTSHADE_ROW_CACHE_BYTES=67108864
LIGHTSHADE_CHECKPOINT_BYTES=8388608
LIGHTSHADE_IDLE_TIMEOUT_MS=30000
LIGHTSHADE_HANDSHAKE_TIMEOUT_MS=10000
LIGHTSHADE_SHUTDOWN_TIMEOUT_MS=10000
LIGHTSHADE_CREDENTIALS_RELOAD_MS=1000
